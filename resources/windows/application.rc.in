#include <windows.h>
IDI_APP_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/windows/app.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "KVM-Win @SHAREKEYS_RESOURCE_ROLE@\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "InternalName", "sharekeys_@SHAREKEYS_RESOURCE_TARGET@\0"
   VALUE "OriginalFilename", "sharekeys_@SHAREKEYS_RESOURCE_TARGET@.exe\0"
   VALUE "ProductName", "KVM-Win / ShareKeys\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
